image:
  registry: ""
  repository: "to-dos-api-cpp"
  tag: "sha-ee367fe12fd7fdb276ec750655a310d4b3bab9c5"
  pullPolicy: "Never"

extraConfigMapEnvVars:
  API_HOST: "0.0.0.0"
  API_PORT: "80"
  API_LOG_LEVEL: "INFO"
  API_NUMBER_OF_THREADS: "1"

extraSecretEnvVars:
  POSTGRES_HOST: "postgresql"
  POSTGRES_PORT: "5432"
  POSTGRES_DB: "to-dos-api-cpp-db"
  POSTGRES_USER: {{ .Values.postgresUsername }}
  POSTGRES_PASSWORD: {{ .Values.postgresPassword }}


initContainers:
  - name: "db-init-and-migrate"
    image: "ghcr.io/tourmalinecore/to-dos-api-cpp:sha-ee367fe12fd7fdb276ec750655a310d4b3bab9c5"
    command: ["/bin/sh", "-c"]
    workingDir: "/app/alembic"
    args:
      - "alembic upgrade head"
    env:
      - name: "POSTGRES_HOST"
        value: "postgresql"
      - name: "POSTGRES_PORT"
        value: "5432"
      - name: "POSTGRES_USER"
        value: {{ .Values.postgresUsername }}
      - name: "POSTGRES_PASSWORD"
        value: {{ .Values.postgresPassword }}
      - name: "POSTGRES_DB"
        value: "to-dos-api-cpp-db"